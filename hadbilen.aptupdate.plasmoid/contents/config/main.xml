<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
  http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
<kcfgfile name=""/>

<group name="shadow">
  <entry name="cmdIsRunning" type="Bool">
    <default>false</default>
  </entry>
</group>

<group name="debugConfigPage">
  <entry name="debugLog" type="String">
    <default>Nothing</default>
  </entry>
</group>

<group name="mouseConfigPage">
  <entry name="invertMouseAction" type="Bool">
    <default>false</default>
  </entry>
  <entry name="mainIsRefresh" type="Bool">
    <default>false</default>
  </entry>
</group>

<group name="commandConfigPage">
  <entry name="updateInterval" type="Int">
    <default>30</default>
  </entry>

  <entry name="updateIntervalUnit" type="Int">
    <default>0</default>
  </entry>

  <entry name="debugMode" type="Bool">
    <default>false</default>
  </entry>

  <entry name="retryMode" type="Bool">
    <default>false</default>
  </entry>

  <entry name="konsoleIsValid" type="Bool">
    <default>false</default>
  </entry>

  <entry name="checkupdateIsValid" type="Bool">
    <default>false</default>
  </entry>

  <entry name="notCloseCommand" type="Bool">
    <default>false</default>
  </entry>

  <entry name="enableSnapUpdates" type="Bool">
    <default>true</default>
  </entry>

  <entry name="enableFlatpakUpdates" type="Bool">
    <default>true</default>
  </entry>

  <entry name="silentUpdate" type="Bool">
    <default>false</default>
  </entry>

  <entry name="notifyOnSilentUpdate" type="Bool">
    <default>true</default>
  </entry>

  <entry name="includePhasedUpdates" type="Bool">
    <default>false</default>
  </entry>

  <entry name="notifyOnRebootRequired" type="Bool">
    <default>true</default>
  </entry>

  <entry name="hasSnap" type="Bool">
    <default>true</default>
  </entry>

  <entry name="hasFlatpak" type="Bool">
    <default>true</default>
  </entry>

  <entry name="updateCommand" type="String">
    <default>sudo apt update &amp;&amp; sudo apt upgrade &amp;&amp; (which snap &gt;/dev/null 2&gt;&amp;1 &amp;&amp; sudo snap refresh || true) &amp;&amp; (which flatpak &gt;/dev/null 2&gt;&amp;1 &amp;&amp; flatpak update -y || true)</default>
  </entry>

  <entry name="updateCommandOne" type="String">
    <default>sudo apt install --only-upgrade</default>
  </entry>

  <entry name="countArchCommand" type="String">
    <default>apt list --upgradable 2&gt;/dev/null | grep -c '\['</default>
  </entry>

  <entry name="countAurCommand" type="String">
    <default>s=0; f=0; which snap &gt;/dev/null 2&gt;&amp;1 &amp;&amp; s=$(snap refresh --list 2&gt;/dev/null | tail -n +2 | wc -l || echo 0); which flatpak &gt;/dev/null 2&gt;&amp;1 &amp;&amp; f=$(flatpak remote-ls --updates 2&gt;/dev/null | wc -l || echo 0); echo $((s + f))</default>
  </entry>

  <entry name="listArchCommand" type="String">
    <default>apt list --upgradable 2&gt;/dev/null | grep '\[' | awk -F'[/ ]+' '{old=$NF; sub(/\]/,"",old); print $1, old, "-&gt;", $3}'</default>
  </entry>

  <entry name="listRepoArchCommand" type="String">
    <default></default>
  </entry>

  <entry name="listAurCommand" type="String">
    <default>(which snap &gt;/dev/null 2&gt;&amp;1 &amp;&amp; snap refresh --list 2&gt;/dev/null | awk 'NR&gt;1 {print $1, "snap", "-&gt;", $2}') ; (which flatpak &gt;/dev/null 2&gt;&amp;1 &amp;&amp; flatpak remote-ls --updates 2&gt;/dev/null | awk '{print $1, "flatpak", "-&gt;", $2}')</default>
  </entry>

  <entry name="termCmd" type="String">
    <default>konsole -e bash -c</default>
  </entry>

  <entry name="termNoCloseCmd" type="String">
    <default>konsole -e bash -c </default>
  </entry>

  <entry name="termNoCloseSuffix" type="String">
    <default>; exec $SHELL</default>
  </entry>
</group>

<group name="displayConfigPage">

  <entry name="icon" type="string">
    <default>software-update-available.svg</default>
  </entry>

  <entry name="secondaryIcon" type="string">
    <default>view-refresh.svg</default>
  </entry>

  <entry name="separateResult" type="Bool">
    <default>false</default>
  </entry>

  <entry name="separator" type="String">
    <default>~</default>
  </entry>

  <entry name="mainDot" type="Bool">
    <default>false</default>
  </entry>

  <entry name="mainDotPosition" type="Enum">
    <choices>
      <choice name="Top Right" />
      <choice name="Top Left" />
      <choice name="Bottom Right" />
      <choice name="Bottom Left" />
    </choices>
    <default>2</default>
  </entry>

  <entry name="secondDot" type="Bool">
    <default>false</default>
  </entry>

  <entry name="secondDotPosition" type="Enum">
    <choices>
      <choice name="Top Right" />
      <choice name="Top Left" />
      <choice name="Bottom Right" />
      <choice name="Bottom Left" />
    </choices>
    <default>3</default>
  </entry>

  <entry name="mainDotColor" type="String">
    <default>white</default>
  </entry>

  <entry name="secondDotColor" type="String">
    <default>white</default>
  </entry>

  <entry name="mainDotUseCustomColor" type="Bool">
    <default>false</default>
  </entry>

  <entry name="secondDotUseCustomColor" type="Bool">
    <default>false</default>
  </entry>

  <entry name="iconColor" type="String">
    <default>white</default>
  </entry>

  <entry name="iconUseCustomColor" type="Bool">
    <default>false</default>
  </entry>

  <entry name="hideOnZero" type="Bool">
    <default>false</default>
  </entry>

  <entry name="notifyOnUpdates" type="Bool">
    <default>false</default>
  </entry>
</group>

<group name="popupConfigPage">

  <entry name="nameUseCustomColor" type="Bool">
    <default>false</default>
  </entry>
  <entry name="nameColor" type="String">
    <default>white</default>
  </entry>

  <entry name="sourceUseCustomColor" type="Bool">
    <default>false</default>
  </entry>
  <entry name="sourceColor" type="String">
    <default>white</default>
  </entry>

  <entry name="separatorUseCustomColor" type="Bool">
    <default>false</default>
  </entry>
  <entry name="separatorColor" type="String">
    <default>white</default>
  </entry>
  <entry name="separatorText" type="String">
    <default>></default>
  </entry>

  <entry name="fvUseCustomColor" type="Bool">
    <default>false</default>
  </entry>
  <entry name="fvColor" type="String">
    <default>white</default>
  </entry>

  <entry name="tvUseCustomColor" type="Bool">
    <default>false</default>
  </entry>
  <entry name="tvColor" type="String">
    <default>white</default>
  </entry>

</group>

</kcfg>
